# Generate a persistent value with:
# .\backend\venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ENVIRONMENT=development
# Comma-separated frontend origins; do not use * for a deployed site.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
